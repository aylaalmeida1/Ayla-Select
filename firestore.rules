rules_version = '2';

// =============================================================
// REGRAS DE SEGURANÇA — Studio Ayla Almeida | Ayla Select
// -------------------------------------------------------------
// - Qualquer pessoa pode LER um cartão específico se tiver o ID
//   (é assim que o QR Code funciona sem exigir login da cliente).
// - Ninguém pode LISTAR todas as clientes sem estar logada.
// - A cliente (sem login) só pode alterar 3 campos do próprio
//   cartão: aceite do regulamento, resposta da avaliação no
//   Google e a escolha do benefício Ouro. Nada mais.
// - Você, logada no painel administrativo, pode fazer qualquer
//   alteração.
// - Configurações gerais: qualquer um pode ler (o cartão precisa
//   do texto do regulamento e do link do Google); só você edita.
// - Registro de alterações (log): só leitura/escrita logada.
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /clientes/{clienteId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['regulamentoAceite', 'avaliacaoGoogle', 'beneficios']);
    }

    match /configuracoes/{docId} {
      allow get: if true;
      allow list, create, update, delete: if request.auth != null;
    }

    match /logAlteracoes/{logId} {
      allow read, write: if request.auth != null;
    }
  }
}

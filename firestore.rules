rules_version = '2';

// =============================================================
// REGRAS DE SEGURANÇA — Studio Ayla Almeida | Clube VIP
// -------------------------------------------------------------
// - Qualquer pessoa pode LER um cartão específico se tiver o ID
//   (é assim que o QR Code funciona sem exigir login da cliente).
// - Ninguém pode LISTAR todas as clientes sem estar logada
//   (isso impede que alguém de fora veja a lista completa).
// - Somente você, logada no painel administrativo, pode
//   CRIAR, EDITAR ou EXCLUIR clientes.
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /clientes/{clienteId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }
  }
}
